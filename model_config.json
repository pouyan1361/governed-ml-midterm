{
  "model_version": "v3",
  "author": "Myong Brian Pak",
  "description": "Gradient boosting on declared application fields plus five driving-history features, with no vendor territory index.",
  "model_type": "gradient_boosting",
  "params": {"n_estimators": 200, "max_depth": 2, "learning_rate": 0.05},
